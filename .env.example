# Copy to .env. Use synthetic data only.
POSTGRES_PASSWORD=swaggy-local-only
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# protected | unrestricted-demo
SECURITY_PROFILE=protected

# Must be explicitly enabled to permit destructive demo actions.
# Never use this profile with anything except the disposable Compose database.
ALLOW_DESTRUCTIVE_DEMO=false

# Control (C2): maximum simultaneous assistant runs. Over this, /api/chat
# returns HTTP 429. Capacity (C4) surfaces this as the scale-out concurrency cap.
MAX_CONCURRENT_RUNS=4

# Address Compose publishes the storefront and API on.
# 0.0.0.0 is required inside a Docker Sandbox so `sbx` can forward the ports
# to the host. If you run `docker compose up` directly on your host instead,
# set this to 127.0.0.1 to keep the ports on loopback only.
BIND_HOST=0.0.0.0
