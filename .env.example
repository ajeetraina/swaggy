# Copy to .env. Use synthetic data only.
POSTGRES_PASSWORD=swaggy-local-only
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# protected | unrestricted-demo
SECURITY_PROFILE=protected

# Must be explicitly enabled to permit destructive demo actions.
# Never use this profile with anything except the disposable Compose database.
ALLOW_DESTRUCTIVE_DEMO=false
